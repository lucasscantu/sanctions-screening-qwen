# ===========================================
# UN Sanctions Screening System Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sanctions_screening
POSTGRES_USER=screening_user
POSTGRES_PASSWORD=change_me_in_production

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=30

# UN Data Source
UN_DATA_SOURCE_URL=https://main.un.org/securitycouncil/en/content/un-sc-consolidated-list

# Sync Schedule (cron expression)
SYNC_CRON_EXPRESSION=0 0 10 * * *

# Application
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO

# Security
JWT_SECRET=change_me_generate_a_random_secret
RATE_LIMIT_PER_MINUTE=60

# Search Configuration
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=100
MIN_SCORE_THRESHOLD=0
